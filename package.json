{
  "name": "hysteria2-c2-advanced",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "postinstall": "bash scripts/patch-lucide.sh",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "clean": "turbo run clean",
    "prisma:generate": "node scripts/run-prisma.js generate",
    "prisma:migrate": "node scripts/run-prisma.js migrate dev",
    "prisma:push": "node scripts/run-prisma.js db push",
    "prisma:studio": "node scripts/run-prisma.js studio",
    "setup:admin": "node scripts/setup-admin.js",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:headed": "playwright test --headed",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "eslint": "^9",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.4.1",
    "prettier": "^3.0.0",
    "socks-proxy-agent": "^10.0.0",
    "turbo": "^2.0.0",
    "typescript": "^5"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.78",
    "@ai-sdk/google": "^3.0.75",
    "@ai-sdk/openai": "^3.0.64",
    "ai": "^6.0.184",
    "yaml": "^2.9.0",
    "zod": "^4.3.6"
  }
}
